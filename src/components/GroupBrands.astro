---
// Logos of the Grupo Herval companies (grayscale, color on hover)
import grupo from '../data/empresas-grupo.json';

interface Props {
  title?: string;
}
const { title = 'Empresas do Grupo Herval' } = Astro.props;
---

<div class="brands">
  {title && <h3>{title}</h3>}
  <ul>
    {
      grupo.map((g) => (
        <li>
          {g.url ? (
            <a href={g.url} target="_blank" rel="noopener" title={g.name}>
              <img src={g.logo} alt={g.name} width="96" height="96" loading="lazy" />
            </a>
          ) : (
            <img src={g.logo} alt={g.name} width="96" height="96" loading="lazy" />
          )}
        </li>
      ))
    }
  </ul>
</div>

<style>
  h3 {
    margin-bottom: 16px;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    place-items: center;
  }

  img {
    width: 100%;
    max-width: 88px;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.3s, opacity 0.3s, transform 0.3s var(--ease);
  }

  a:hover img,
  a:focus-visible img {
    filter: none;
    opacity: 1;
    transform: scale(1.06);
  }

  @media (max-width: 1024px) {
    ul {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (max-width: 767px) {
    ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
