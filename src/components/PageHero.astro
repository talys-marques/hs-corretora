---
// Full-width banner with a dark overlay and the page H1 (used on every inner page)
interface Props {
  title: string;
  image: string;
  subtitle?: string;
  size?: 'sm' | 'lg';
  upper?: boolean;
}
const { title, image, subtitle, size = 'sm', upper = size === 'sm' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${size}`, { 'page-hero--upper': upper }]}>
  <img class="page-hero__bg" src={image} alt="" fetchpriority="high" decoding="async" />
  <div class="container page-hero__content">
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 320px;
    color: var(--white);
    text-align: center;
    background: var(--navy);
    overflow: hidden;
  }

  .page-hero--lg {
    min-height: min(78vh, 680px);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.55);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    padding-block: 48px;
  }

  h1 {
    margin: 0;
    color: var(--white);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 600;
  }

  .page-hero--upper h1 {
    text-transform: uppercase;
  }

  p {
    max-width: 640px;
    margin: 14px auto 0;
    font-size: clamp(1rem, 2vw, 1.125rem);
  }

  .page-hero__content :global(.btn) {
    margin-top: 24px;
  }

  @media (max-width: 767px) {
    .page-hero {
      min-height: 220px;
    }

    .page-hero--lg {
      min-height: 480px;
    }
  }
</style>
