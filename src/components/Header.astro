---
import { site, nav } from '../config/site';
import Icon from './Icon.astro';
import { stripBase } from '../lib/url';
import { getProducts, audienceInfo } from '../lib/products';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) => href !== '/' && current.startsWith(href);

const groups = [
  { ...audienceInfo.pf, items: await getProducts('pf') },
  { ...audienceInfo.pj, items: await getProducts('pj') },
];
const productSlugs = new Set(groups.flatMap((g) => g.items.map((p) => `/${p.id}/`)));
const insuranceActive = current === '/para-voce/' || current === '/para-empresas/' || productSlugs.has(current);
const sinistro = site.phones[2];
const cotacao = site.phones[1];
---

<div class="topbar">
  <div class="container topbar__inner">
    <span>Uma empresa do Grupo Herval</span>
    <div class="topbar__links">
      <a href={`tel:${sinistro.tel}`}><Icon name="clock" size={14} /> Sinistro 24h: <strong>{sinistro.number}</strong></a>
      <a href={`tel:${cotacao.tel}`}><Icon name="phone" size={14} /> Cotações: <strong>{cotacao.number}</strong></a>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} - página inicial`}>
      <img src={site.logo} alt={site.name} width="190" height="46" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Menu principal">
      <ul class="menu">
        <li class="has-mega" data-mega>
          <button class="menu-link" type="button" aria-expanded="false" aria-controls="mega-seguros" data-active={insuranceActive ? '' : undefined}>
            Seguros <Icon name="chevron-down" size={18} class="chev" />
          </button>
          <div class="mega" id="mega-seguros">
            {
              groups.map((g) => (
                <div class="mega__col">
                  <a class="mega__title" href={g.href}>
                    {g.label}
                    <span>{g.items.length} seguros</span>
                    <Icon name="arrow-right" size={16} />
                  </a>
                  <ul class="mega__list">
                    {g.items.map((p) => (
                      <li>
                        <a href={`/${p.id}/`} aria-current={current === `/${p.id}/` ? 'page' : undefined}>
                          {p.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
            <div class="mega__promo">
              <p class="mega__promo-title">Não sabe qual seguro escolher?</p>
              <p>Um especialista ajuda você a encontrar a proteção certa.</p>
              <a class="btn btn--primary" href={site.quote.primaryUrl} target="_blank" rel="noopener">Fazer cotação</a>
              <a class="mega__wa" href={`https://wa.me/${site.whatsapp.number}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={16} /> Falar no WhatsApp</a>
            </div>
          </div>
        </li>
        {
          nav.map((item) => (
            <li>
              <a
                class="menu-link"
                href={item.href}
                aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-mobile-contact">
        <a href={`tel:${sinistro.tel}`}><Icon name="clock" size={16} /> Sinistro 24h: {sinistro.number}</a>
        <a href={`tel:${cotacao.tel}`}><Icon name="phone" size={16} /> Cotações: {cotacao.number}</a>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn--primary header-cta" href={site.quote.primaryUrl} target="_blank" rel="noopener">
        Fazer cotação
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="icon-open"><Icon name="menu" size={26} /></span>
        <span class="icon-close"><Icon name="close" size={26} /></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const mega = header?.querySelector<HTMLElement>('[data-mega]');
  const megaBtn = mega?.querySelector<HTMLButtonElement>('button');

  // Mobile menu
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  });

  // Insurance mega menu: click/keyboard toggle (hover is handled in CSS on desktop)
  const setMega = (open: boolean) => {
    megaBtn?.setAttribute('aria-expanded', String(open));
    mega?.classList.toggle('is-open', open);
  };
  megaBtn?.addEventListener('click', () => setMega(megaBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mega?.classList.contains('is-open')) {
      setMega(false);
      megaBtn?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (mega && !mega.contains(e.target as Node)) setMega(false);
  });

  // Shadow once the page scrolls
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* ---------- Top bar ---------- */
  .topbar {
    background: var(--ink);
    color: rgb(255 255 255 / 0.7);
    font-size: 0.8rem;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 36px;
  }

  .topbar__links {
    display: flex;
    gap: 24px;
  }

  .topbar a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    text-decoration: none;
  }

  .topbar a:hover {
    color: var(--white);
  }

  .topbar strong {
    color: var(--white);
    font-weight: 600;
  }

  /* ---------- Main bar ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(30 26 52 / 0.96);
    backdrop-filter: saturate(140%) blur(10px);
    color: var(--white);
    transition: box-shadow 0.25s;
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 24px rgb(23 20 43 / 0.25);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 76px;
  }

  .brand {
    flex: none;
  }

  .brand img {
    width: 168px;
    height: auto;
  }

  .site-nav {
    flex: 1;
  }

  .menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 40px;
    padding: 8px 14px;
    border: 0;
    border-radius: 10px;
    background: none;
    color: rgb(255 255 255 / 0.85);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .menu-link:hover,
  .has-mega:hover > .menu-link,
  .has-mega.is-open > .menu-link {
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
  }

  .menu-link[aria-current='page'],
  .menu-link[data-active] {
    background: rgb(255 255 255 / 0.12);
    color: var(--white);
  }

  .menu-link :global(.chev) {
    transition: transform 0.2s;
  }

  .has-mega.is-open :global(.chev) {
    transform: rotate(180deg);
  }

  .header-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  .header-cta {
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 0.92rem;
    text-transform: none;
  }

  /* ---------- Mega menu ---------- */
  .has-mega {
    position: static;
  }

  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    display: grid;
    grid-template-columns: 1.5fr 1.2fr 1fr;
    gap: 32px;
    width: min(var(--container), calc(100vw - 32px));
    padding: 28px;
    border-radius: 0 0 20px 20px;
    background: var(--white);
    box-shadow: var(--shadow-lift);
    color: var(--ink);
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -6px);
    transition: opacity 0.2s, transform 0.2s var(--ease), visibility 0.2s;
  }

  /* Hover bridge so the panel does not close between the button and the panel */
  .mega::before {
    content: '';
    position: absolute;
    inset: -16px 0 auto;
    height: 16px;
  }

  .has-mega.is-open .mega {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (hover: hover) and (min-width: 1025px) {
    .has-mega:hover .mega {
      visibility: visible;
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  .mega__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .mega__title span {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .mega__title :global(svg) {
    margin-left: auto;
    color: var(--red);
    transition: transform 0.2s var(--ease);
  }

  .mega__title:hover :global(svg) {
    transform: translateX(3px);
  }

  .mega__list {
    columns: 2;
    column-gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega__col:nth-child(2) .mega__list {
    columns: 2;
  }

  .mega__list a {
    display: block;
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--text);
    font-size: 0.9rem;
    text-decoration: none;
    break-inside: avoid;
  }

  .mega__list a:hover,
  .mega__list a[aria-current='page'] {
    background: var(--surface);
    color: var(--red);
  }

  .mega__promo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 24px;
    border-radius: 16px;
    background:
      radial-gradient(80% 80% at 100% 0%, rgb(217 33 46 / 0.12), transparent 70%),
      var(--surface);
  }

  .mega__promo p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .mega__promo .mega__promo-title {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .mega__promo .btn {
    margin-top: 8px;
    border-radius: 10px;
    text-transform: none;
  }

  .mega__wa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .mega__wa:hover {
    color: var(--red);
  }

  .nav-mobile-contact,
  .menu-toggle {
    display: none;
  }

  .menu-toggle {
    padding: 8px;
    border: 0;
    border-radius: 10px;
    background: none;
    color: var(--white);
    cursor: pointer;
  }

  .menu-toggle .icon-close {
    display: none;
  }

  /* ---------- Tablet / mobile ---------- */
  @media (max-width: 1024px) {
    .topbar {
      display: none;
    }

    /* backdrop-filter would make the fixed menu panel relative to the header */
    .site-header {
      background: var(--navy);
      backdrop-filter: none;
    }

    .header-inner {
      justify-content: space-between;
      min-height: var(--header-h);
    }

    .menu-toggle {
      display: block;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 24px;
      padding: 16px var(--gutter) 32px;
      background: var(--navy);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    }

    .is-open .site-nav {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .is-open .icon-open {
      display: none;
    }

    .is-open .icon-close {
      display: block;
    }

    .menu {
      flex-direction: column;
      align-items: stretch;
    }

    .menu > li {
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }

    .menu-link {
      justify-content: space-between;
      width: 100%;
      min-height: 52px;
      padding: 12px 4px;
      border-radius: 0;
      font-size: 1.05rem;
    }

    .menu-link[aria-current='page'],
    .menu-link[data-active],
    .menu-link:hover {
      background: none;
      color: #ff8a92;
    }

    .mega {
      position: static;
      display: none;
      width: auto;
      padding: 0 0 16px;
      border-radius: 0;
      background: none;
      box-shadow: none;
      color: var(--white);
      visibility: visible;
      opacity: 1;
      transform: none;
      gap: 20px;
    }

    .has-mega.is-open .mega {
      display: grid;
      grid-template-columns: 1fr;
      transform: none;
    }

    .mega__title {
      border-color: rgb(255 255 255 / 0.12);
      color: var(--white);
    }

    .mega__title span {
      color: rgb(255 255 255 / 0.6);
    }

    .mega__list a {
      color: rgb(255 255 255 / 0.85);
    }

    .mega__list a:hover,
    .mega__list a[aria-current='page'] {
      background: rgb(255 255 255 / 0.08);
      color: var(--white);
    }

    .mega__promo {
      display: none;
    }

    .nav-mobile-contact {
      display: grid;
      gap: 12px;
    }

    .nav-mobile-contact a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: rgb(255 255 255 / 0.85);
      text-decoration: none;
    }

    :global(body.menu-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 767px) {
    .brand img {
      width: 140px;
    }

    .header-cta {
      display: none;
    }
  }
</style>
