---
// Product listing with an instant search filter (works without JS as a plain grid)
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import { whatsappLink } from '../config/site';
import { getProducts, type Audience } from '../lib/products';

interface Props {
  audience: Audience;
}
const { audience } = Astro.props;
const products = await getProducts(audience);
---

<section class="container listing" data-listing aria-labelledby="listing-title">
  <div class="listing__head">
    <div>
      <h2 id="listing-title" class="heading-xl">Escolha o seguro ideal</h2>
      <p class="count" data-count aria-live="polite">{products.length} seguros disponíveis</p>
    </div>
    <label class="search">
      <span class="sr-only">Buscar seguro</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M10 2a8 8 0 1 0 4.9 14.32l5.39 5.39 1.42-1.42-5.39-5.39A8 8 0 0 0 10 2Zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12Z"></path></svg>
      <input type="search" placeholder="Buscar seguro…" autocomplete="off" data-search-input />
    </label>
  </div>

  <ul class="grid">
    {
      products.map((p) => (
        <li>
          <ProductCard product={p} />
        </li>
      ))
    }
  </ul>

  <div class="empty" data-empty hidden>
    <p><strong>Não encontramos esse seguro na lista.</strong> Mesmo assim, podemos ajudar: fale com um especialista.</p>
    <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Falar no WhatsApp</a>
  </div>
</section>

<script>
  const normalize = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');

  document.querySelectorAll<HTMLElement>('[data-listing]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const items = [...root.querySelectorAll<HTMLElement>('.grid > li')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const total = items.length;

    input?.addEventListener('input', () => {
      const q = normalize(input.value.trim());
      let visible = 0;
      items.forEach((li) => {
        const text = normalize(li.querySelector<HTMLElement>('[data-search]')?.dataset.search ?? '');
        const match = !q || text.includes(q);
        li.hidden = !match;
        if (match) visible++;
      });
      if (count) count.textContent = q ? `${visible} de ${total} seguros` : `${total} seguros disponíveis`;
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

<style>
  .listing {
    padding-block: clamp(48px, 6vw, 80px) 0;
  }

  .listing__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .listing__head .heading-xl {
    margin-bottom: 4px;
  }

  .count {
    margin: 0;
    color: var(--text-muted);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    width: min(100%, 340px);
  }

  .search svg {
    position: absolute;
    left: 14px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search input {
    width: 100%;
    min-height: 48px;
    padding: 10px 16px 10px 44px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--white);
    font: inherit;
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search input:focus {
    border-color: var(--red);
    outline: none;
    box-shadow: 0 0 0 4px rgb(217 33 46 / 0.12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li[hidden] {
    display: none;
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px;
    border-radius: 20px;
    background: var(--surface);
  }

  .empty[hidden] {
    display: none;
  }

  .empty p {
    margin: 0;
  }

  .empty .btn {
    border-radius: 12px;
    text-transform: none;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .search {
      width: 100%;
    }
  }
</style>
