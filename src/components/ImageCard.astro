---
// Photo card with overlay, title and outline button (product cards and home banners)
interface Props {
  title: string;
  href: string;
  image: string;
  text?: string;
  cta?: string;
  tall?: boolean;
}
const { title, href, image, text, cta = 'Saiba mais', tall = false } = Astro.props;
---

<a class:list={['image-card', { 'image-card--tall': tall }]} href={href}>
  <img src={image} alt="" loading="lazy" decoding="async" />
  <span class="image-card__body">
    <span class="image-card__title">{title}</span>
    {text && <span class="image-card__text">{text}</span>}
    <span class="btn btn--outline">{cta}</span>
  </span>
</a>

<style>
  .image-card {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 210px;
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--white);
    text-align: center;
    text-decoration: none;
    isolation: isolate;
  }

  .image-card--tall {
    min-height: 460px;
    border-radius: 0;
  }

  img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .image-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.45);
    transition: background-color 0.3s;
  }

  .image-card:hover img,
  .image-card:focus-visible img {
    transform: scale(1.06);
  }

  .image-card:hover::before {
    background: rgb(0 0 0 / 0.6);
  }

  .image-card__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px;
  }

  .image-card__title {
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 500;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .image-card--tall .image-card__title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 600;
  }

  .image-card__text {
    max-width: 360px;
  }

  .btn {
    min-height: 38px;
    padding: 6px 22px;
    font-size: 0.75rem;
  }

  @media (max-width: 767px) {
    .image-card--tall {
      min-height: 340px;
    }
  }
</style>
