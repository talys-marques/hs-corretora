---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { postUrl, formatDate, postCategories } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const d = post.data;
const categories = postCategories(post);
const category = categories[0] ?? 'Seguros';
---

<article class:list={['post-card', { 'post-card--featured': featured }]} data-categories={categories.join('|')}>
  <a href={postUrl(post)} class="thumb" tabindex="-1" aria-hidden="true">
    {
      d.image ? (
        <img src={d.image} alt="" loading={featured ? 'eager' : 'lazy'} decoding="async" />
      ) : (
        <span class="placeholder">
          <Icon name="shield" size={featured ? 56 : 40} />
          <span>{category}</span>
        </span>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      <span class="tag">{category}</span>
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
    </p>
    <h2><a href={postUrl(post)}>{d.title}</a></h2>
    <p class="excerpt">{d.description}</p>
    <span class="more" aria-hidden="true">Ler artigo <Icon name="arrow-right" size={16} class="arrow" /></span>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    background: var(--white);
    transition: border-color 0.2s, box-shadow 0.25s, transform 0.25s var(--ease);
  }

  .post-card:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lift);
    transform: translateY(-4px);
  }

  /* Whole card clickable through the title link */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--navy);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .post-card:hover .thumb img {
    transform: scale(1.05);
  }

  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    height: 100%;
    padding: 16px;
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(217 33 46 / 0.55), transparent 65%),
      linear-gradient(135deg, var(--ink), var(--navy-soft));
    color: rgb(255 255 255 / 0.9);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .placeholder :global(svg) {
    color: rgb(255 255 255 / 0.35);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 22px 22px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-bottom: 10px;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--red-soft);
    color: var(--red);
    font-weight: 700;
  }

  h2 {
    margin-bottom: 8px;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-card:hover h2 a {
    color: var(--red);
  }

  .excerpt {
    display: -webkit-box;
    flex: 1;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.92rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--red);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .post-card:hover :global(.arrow) {
    transform: translateX(3px);
  }

  /* Featured: horizontal on wide screens */
  .post-card--featured {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .post-card--featured .thumb {
    aspect-ratio: auto;
    min-height: 320px;
  }

  .post-card--featured .body {
    justify-content: center;
    padding: clamp(24px, 4vw, 44px);
  }

  .post-card--featured h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .post-card--featured .excerpt {
    flex: 0;
    margin-bottom: 20px;
    font-size: 1rem;
  }

  @media (max-width: 1024px) {
    .post-card--featured {
      grid-template-columns: 1fr;
    }

    .post-card--featured .thumb {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }
  }
</style>
