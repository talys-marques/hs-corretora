---
// Key numbers of the Grupo Herval (home and "Sobre nós")
import parceiras from '../data/seguradoras-parceiras.json';

const partnersCount = Math.floor(parceiras.length / 10) * 10;
const stats = [
  { value: '1959', label: 'ano de fundação do Grupo Herval' },
  { value: '27', label: 'marcas no grupo' },
  { value: '20+', label: 'países com presença do grupo' },
  { value: `${partnersCount}+`, label: 'seguradoras parceiras' },
];
---

<dl class="stats">
  {
    stats.map((s) => (
      <div>
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 24px;
    border-radius: 20px;
    background: var(--white);
    box-shadow: var(--shadow-soft);
  }

  dd {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  dt {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 1024px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .stats div {
      padding: 18px;
    }
  }
</style>
