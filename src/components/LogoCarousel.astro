---
// Horizontal logo carousel using native scroll-snap; arrows only scroll the track (replaces Swiper)
interface Props {
  logos: { name: string; logo: string }[];
  label: string;
}
const { logos, label } = Astro.props;
---

<div class="logo-carousel" data-carousel>
  <button class="nav prev" type="button" aria-label="Anterior" data-dir="-1">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12l4.58-4.59Z"></path></svg>
  </button>
  <ul class="track" aria-label={label} tabindex="0">
    {
      logos.map((l) => (
        <li>
          <img src={l.logo} alt={l.name} loading="lazy" decoding="async" />
        </li>
      ))
    }
  </ul>
  <button class="nav next" type="button" aria-label="Próximo" data-dir="1">
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12l-4.58 4.59Z"></path></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track');
    if (!track) return;
    root.querySelectorAll<HTMLButtonElement>('.nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir);
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
        const atStart = track.scrollLeft <= 4;
        // Wrap around at the edges, like the old carousel loop
        if (dir > 0 && atEnd) track.scrollTo({ left: 0, behavior: 'smooth' });
        else if (dir < 0 && atStart) track.scrollTo({ left: track.scrollWidth, behavior: 'smooth' });
        else track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: 'smooth' });
      });
    });
  });
</script>

<style>
  .logo-carousel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
  }

  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 5 * 24px) / 6);
    gap: 24px;
    margin: 0;
    padding: 8px 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  li {
    display: grid;
    place-items: center;
    scroll-snap-align: start;
  }

  /* Source logos are 150x150 squares with built-in padding */
  img {
    width: 100%;
    max-width: 150px;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--red);
    cursor: pointer;
  }

  .nav:hover {
    background: rgb(217 33 46 / 0.08);
  }

  @media (max-width: 1024px) {
    .track {
      grid-auto-columns: calc((100% - 3 * 24px) / 4);
    }
  }

  @media (max-width: 767px) {
    .track {
      grid-auto-columns: calc((100% - 16px) / 2);
      gap: 16px;
    }
  }
</style>
