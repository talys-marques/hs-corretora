---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ajuda from '../data/ajuda.json';

const digits = (s: string) => s.replace(/\D/g, '');
const waHref = (s: string) => `https://wa.me/55${digits(s)}`;
const telHref = (s: string) => (digits(s).startsWith('0') ? `tel:${digits(s)}` : `tel:+55${digits(s)}`);
---

<Base title="Ajuda" description="Em caso de sinistro, contatos das seguradoras parceiras (WhatsApp e 0800) e links úteis: FIPE, Delegacia Online, Detran RS e SUSEP.">
  <PageHero title="Ajuda" image="/uploads/2021/12/banner-ajuda.webp" />

  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <h2>Dúvidas, reclamações ou sugestões?</h2>
        <p>Entre em contato com a gente, responderemos o mais rápido possível.</p>
      </div>

      <div class="accordion">
        <details open>
          <summary><Icon name="chevron-down" /> Em caso de sinistro</summary>
          <div class="panel">
            <p>Problemas acontecem, estamos aqui para ajudar.</p>
            <p>
              <a href={ajuda.sinistroPdf} target="_blank" rel="noopener">Clique aqui</a> e conheça todo o procedimento em caso de sinistro de veículos e demais produtos e serviços.
            </p>
          </div>
        </details>

        <details>
          <summary><Icon name="chevron-down" /> Seguradoras</summary>
          <div class="panel">
            <ul class="insurers">
              {
                ajuda.seguradoras.map((s) => (
                  <li>
                    {s.logo && <img src={s.logo} alt="" width="120" height="60" loading="lazy" />}
                    <div>
                      <h3>{s.name}</h3>
                      {s.whatsapp && (
                        <p>
                          WhatsApp:{' '}
                          <a href={waHref(s.whatsapp)} target="_blank" rel="noopener">
                            {s.whatsapp}
                          </a>
                        </p>
                      )}
                      {s.phone && (
                        <p>
                          Ligação: <a href={telHref(s.phone)}>{s.phone}</a>
                        </p>
                      )}
                      {s.site && (
                        <p>
                          <a href={s.site} target="_blank" rel="noopener">
                            Visite o site <span class="sr-only">da {s.name}</span>
                          </a>
                        </p>
                      )}
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>

        <details>
          <summary><Icon name="chevron-down" /> Links úteis</summary>
          <div class="panel">
            <ul class="links">
              {
                ajuda.links.map((l) => (
                  <li>
                    <strong>{l.label}</strong>
                    <a href={l.url} target="_blank" rel="noopener">
                      {l.url}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 1000px;
  }

  .accordion {
    border-radius: 4px;
    box-shadow: var(--shadow-sm);
  }

  details + details {
    border-top: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 24px;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(svg) {
    color: var(--red);
    transition: transform 0.2s;
  }

  details[open] summary {
    color: var(--red);
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .panel {
    padding: 4px 24px 24px;
    background: #fafafa;
  }

  .panel > p:first-child {
    padding-top: 16px;
  }

  .insurers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 40px;
    margin: 0;
    padding: 16px 0 0;
    list-style: none;
  }

  .insurers li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 16px 0;
  }

  .insurers img {
    flex: none;
    width: 120px;
    object-fit: contain;
  }

  .insurers h3 {
    margin-bottom: 8px;
    color: var(--red);
    font-size: 1.05rem;
    text-transform: uppercase;
  }

  .insurers p {
    margin: 0 0 4px;
    font-size: 0.95rem;
  }

  .insurers a,
  .links a {
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
    word-break: break-word;
  }

  .insurers a:hover,
  .links a:hover {
    color: var(--red);
    text-decoration: underline;
  }

  .links {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 16px 0 0;
    list-style: none;
  }

  .links li {
    display: grid;
  }

  @media (max-width: 767px) {
    .insurers {
      grid-template-columns: 1fr;
    }

    .insurers img {
      width: 90px;
    }

    summary {
      padding: 18px 16px;
    }

    .panel {
      padding-inline: 16px;
    }
  }
</style>
