---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductGrid from '../components/ProductGrid.astro';
import AudienceSwitch from '../components/AudienceSwitch.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../config/site';
---

<Base title="Seguros para empresas" description="Seguros corporativos para proteger seu negócio: empresarial, frota, responsabilidade civil, vida em grupo, transporte e mais.">
  <PageIntro
    crumbs={[{ label: 'Para empresas' }]}
    eyebrow="Toda empresa precisa ter segurança"
    title="Seguros para proteger o seu negócio"
    lead="Aqui sua empresa conta com serviços, coberturas e benefícios exclusivos. Conheça os seguros corporativos e proteja seu empreendimento de imprevistos."
    image="/images/paginas/pj-intro.webp"
  >
    <a class="btn btn--primary btn--lg" href={site.quote.primaryUrl} target="_blank" rel="noopener">
      Fazer cotação <Icon name="arrow-right" size={18} class="arrow" />
    </a>
    <a class="btn btn--dark-outline btn--lg" href={whatsappLink('Olá, gostaria de fazer uma cotação de seguro para minha empresa')} target="_blank" rel="noopener">
      <Icon name="whatsapp" size={18} /> Falar no WhatsApp
    </a>
  </PageIntro>

  <ProductGrid audience="pj" />

  <AudienceSwitch
    title="Procurando seguro para você?"
    text="Automóvel, residencial, vida, viagem, celular e mais."
    href="/para-voce/"
    image="/images/paginas/pf-card.webp"
  />

  <FinalCta title="Vamos proteger o seu negócio?" whatsappMessage="Olá, gostaria de fazer uma cotação de seguro para minha empresa" />
</Base>
