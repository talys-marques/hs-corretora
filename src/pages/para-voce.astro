---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductGrid from '../components/ProductGrid.astro';
import AudienceSwitch from '../components/AudienceSwitch.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { site, whatsappLink } from '../config/site';
---

<Base title="Seguros para você" description="Seguros para você, sua família e seu patrimônio: automóvel, residencial, vida, viagem, celular e muito mais. Solicite uma cotação personalizada.">
  <PageIntro
    crumbs={[{ label: 'Para você' }]}
    eyebrow="Compromisso com sua satisfação"
    title="Seguros para você, sua família e seu patrimônio"
    lead="Estamos prontos para oferecer um atendimento personalizado e uma experiência positiva na escolha do seu seguro. Conheça as opções e solicite uma cotação sob medida."
    image="/images/paginas/pf-intro.webp"
  >
    <a class="btn btn--primary btn--lg" href={site.quote.primaryUrl} target="_blank" rel="noopener">
      Fazer cotação <Icon name="arrow-right" size={18} class="arrow" />
    </a>
    <a class="btn btn--dark-outline btn--lg" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Falar no WhatsApp</a>
  </PageIntro>

  <ProductGrid audience="pf" />

  <AudienceSwitch
    title="Procurando seguro para sua empresa?"
    text="Empresarial, frota, vida em grupo, responsabilidade civil e mais."
    href="/para-empresas/"
    image="/images/paginas/pj-card.webp"
  />

  <FinalCta />
</Base>
