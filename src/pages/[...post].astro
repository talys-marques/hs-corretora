---
// Blog post at its original WordPress permalink: /AAAA/MM/DD/slug/
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { site, whatsappLink } from '../config/site';
import { getPosts, postPath, formatDate } from '../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { post: postPath(post) },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(Math.max(0, i - 1), Math.max(0, i - 1) + 3) },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(Astro.url.pathname, site.url).href;

const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    inLanguage: 'pt-BR',
    mainEntityOfPage: url,
    ...(d.image ? { image: new URL(d.image, site.url).href } : {}),
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---

<Base title={d.title} description={d.description} image={d.image || undefined} type="article" schema={schema}>
  <article class="container section post">
    <nav class="breadcrumb" aria-label="Você está em">
      <a href="/">Início</a> / <a href="/blog/">Blog</a>
    </nav>
    <header>
      <h1>{d.title}</h1>
      <p class="meta">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        {d.categories.length > 0 && <span> · {d.categories.join(', ')}</span>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>

    <aside class="cta">
      <p><strong>Ficou com alguma dúvida?</strong> Nosso time de especialistas pode ajudar você a escolher o seguro ideal.</p>
      <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener">Falar com um especialista</a>
    </aside>
  </article>

  {
    related.length > 0 && (
      <section class="section section--gray" aria-labelledby="related">
        <div class="container">
          <h2 id="related" class="section-head">
            Leia também
          </h2>
          <div class="related">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .post {
    max-width: 860px;
  }

  .breadcrumb {
    margin-bottom: 20px;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .breadcrumb a {
    color: inherit;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .meta {
    margin-bottom: 32px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding: 24px 28px;
    border-left: 4px solid var(--red);
    border-radius: 8px;
    background: var(--gray-bg);
  }

  .cta p {
    flex: 1 1 320px;
    margin: 0;
  }

  .related {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  @media (max-width: 1024px) {
    .related {
      grid-template-columns: 1fr;
    }
  }
</style>
