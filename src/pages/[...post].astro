---
// Blog post at its original WordPress permalink: /AAAA/MM/DD/slug/
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { getPosts, postPath, formatDate, postCategories } from '../lib/blog';
import { stripBase } from '../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Related: same category first, then the most recent others
    const others = posts.filter((p) => p.id !== post.id);
    const mine = postCategories(post);
    const sameCategory = others.filter((p) => postCategories(p).some((c) => mine.includes(c)));
    const related = [...new Set([...sameCategory, ...others])].slice(0, 3);
    return { params: { post: postPath(post) }, props: { post, related } };
  });
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(stripBase(Astro.url.pathname), site.url).href;
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

const share = [
  { name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${d.title} ${url}`)}` },
  { name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { name: 'Facebook', icon: 'facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
] as const;

const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    inLanguage: 'pt-BR',
    mainEntityOfPage: url,
    ...(d.image ? { image: new URL(d.image, site.url).href } : {}),
    author: { '@id': `${site.url}/#organization` },
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---

<Base title={d.title} description={d.description} image={d.image || undefined} type="article" schema={schema}>
  <article>
    <header class="post-head">
      <div class="container post-head__inner">
        <nav class="crumbs" aria-label="Você está em">
          <ol>
            <li><a href="/">Início</a></li>
            <li><a href="/blog/">Blog</a></li>
          </ol>
        </nav>
        {postCategories(post).length > 0 && <p class="eyebrow">{postCategories(post).join(' · ')}</p>}
        <h1>{d.title}</h1>
        <div class="post-meta">
          <span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time> · {minutes} min de leitura</span>
          <ul class="share" aria-label="Compartilhar">
            {
              share.map((s) => (
                <li>
                  <a href={s.href} target="_blank" rel="noopener" aria-label={`Compartilhar no ${s.name}`}>
                    <Icon name={s.icon} size={16} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </header>

    <div class="container post-body">
      {d.image && <img class="cover" src={d.image} alt={d.imageAlt} decoding="async" />}
      <div class="prose">
        <Content />
      </div>

      <aside class="post-cta">
        <span class="post-cta__icon"><Icon name="shield" size={24} /></span>
        <div>
          <p class="post-cta__title">Ficou com alguma dúvida?</p>
          <p>Nosso time de especialistas ajuda você a escolher o seguro ideal.</p>
        </div>
        <a class="btn btn--primary btn--lg" href={site.quote.primaryUrl} target="_blank" rel="noopener">
          Fazer cotação <Icon name="arrow-right" size={18} class="arrow" />
        </a>
      </aside>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section related" aria-labelledby="related">
        <div class="container">
          <div class="related__head">
            <h2 id="related" class="heading-xl">
              Leia também
            </h2>
            <a class="text-link" href="/blog/">
              Ver todos os posts <Icon name="arrow-right" size={16} />
            </a>
          </div>
          <ul class="related__grid">
            {related.map((p) => (
              <li>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <FinalCta />
</Base>

<style>
  .post-head {
    padding-block: clamp(32px, 5vw, 64px);
    background:
      radial-gradient(55% 80% at 100% 0%, rgb(217 33 46 / 0.09), transparent 60%),
      var(--surface);
  }

  .post-head__inner {
    max-width: calc(800px + var(--gutter) * 2);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    opacity: 0.5;
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--red);
  }

  h1 {
    margin-bottom: 20px;
    color: var(--ink);
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .share {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--white);
    color: var(--ink);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .share a:hover {
    border-color: var(--red);
    background: var(--red);
    color: var(--white);
  }

  .post-body {
    max-width: calc(800px + var(--gutter) * 2);
    padding-block: clamp(32px, 5vw, 56px) clamp(48px, 6vw, 72px);
  }

  .cover {
    width: 100%;
    margin-bottom: 32px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .prose {
    max-width: none;
    color: var(--text);
    font-size: 1.075rem;
    line-height: 1.75;
  }

  .prose :global(p > strong:only-child) {
    display: block;
    margin-top: 1.8em;
    color: var(--ink);
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .prose :global(a) {
    font-weight: 600;
  }

  .post-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
    margin-top: 48px;
    padding: 24px;
    border-radius: 20px;
    background: var(--surface);
  }

  .post-cta > div {
    flex: 1 1 260px;
  }

  .post-cta p {
    margin: 0;
    color: var(--text-muted);
  }

  .post-cta .post-cta__title {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .post-cta__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--red);
    color: var(--white);
  }

  .related {
    background: var(--surface);
  }

  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }

  .related__head .heading-xl {
    margin: 0;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1024px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .related__grid li:nth-child(3) {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .related__grid {
      grid-template-columns: 1fr;
    }

    .related__grid li:nth-child(3) {
      display: block;
    }

    .post-cta .btn {
      width: 100%;
    }
  }
</style>
